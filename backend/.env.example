# Database
DATABASE_URL=sqlite+aiosqlite:///./chenforge.db

# Auth
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx

# Notification (Feishu)
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# Admin
ADMIN_TOKEN=change-me-admin-token

# LLM
LLM_PROVIDER=mock
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding (P6.7)
# 默认 mock：本地确定性向量，不访问网络，不外发知识库文本。
# 改为 openai_compatible 才会把 KnowledgeItem 文本发送到 EMBEDDING_BASE_URL。
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock_hash_embedding_v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=0
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_MAX_INPUT_CHARS=12000
# openai_compatible 示例：
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxxxxxxx
# EMBEDDING_DIM=1536

# Vector Store (P6.8)
# 默认 sqlite_json：向量存 JSON、Python cosine 检索，本地开发无需 Postgres。
# pgvector 需要 Postgres + pgvector extension，且 EMBEDDING_DIM 必须 > 0。
VECTOR_STORE=sqlite_json
PGVECTOR_INDEX_TYPE=hnsw
PGVECTOR_DISTANCE=cosine
PGVECTOR_PROBES=10
# 生产 pgvector 示例（需先跑 python scripts/setup_pgvector.py）：
# DATABASE_URL=postgresql+psycopg://chenforge:password@postgres:5432/chenforge
# VECTOR_STORE=pgvector
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=https://llm-gateway.company.internal/v1
# EMBEDDING_API_KEY=...
# EMBEDDING_DIM=1024

# Upload
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20
